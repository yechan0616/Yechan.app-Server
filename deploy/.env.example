# Copy to deploy/.env and chmod 600.

DB_NAME=yechan
DB_USERNAME=yechan
# openssl rand -base64 32
DB_PASSWORD=

APP_CORS_ALLOWED_ORIGINS=https://www.yechan.app,https://studio.yechan.app
# Only for the first passkey enrollment. Clear it afterwards.
AUTH_SETUP_TOKEN=

CLOUDFLARE_TUNNEL_TOKEN=

BACKUP_AT=04:00
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
# age public key (age1...). Keep the private key off the server.
BACKUP_AGE_RECIPIENT=
# e.g. r2:yechan-backups/postgres
BACKUP_REMOTE=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
BACKUP_HEALTHCHECK_URL=
